{
  "manifestVersion": 5,
  "id": "com.adobe-mcp.photoshop",
  "name": "Adobe MCP for Photoshop",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.0.0" },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": ["ws://127.0.0.1:*"] }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": { "default": "Adobe MCP" },
      "minimumSize": { "width": 240, "height": 160 },
      "maximumSize": { "width": 1200, "height": 900 },
      "preferredDockedSize": { "width": 320, "height": 480 }
    }
  ]
}
